{
  "name": "teawork-be",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch --env-file=.env.development src/index.ts",
    "type-check": "tsc --noEmit",
    "lint": "eslint",
    "db-generate": "drizzle-kit generate",
    "env-dev": "DATABASE_URL=$(grep DATABASE_URL -w .env.development | cut -d '=' -f2- | cut -d '\"' -f2 )",
    "db-migrate-dev": "pnpm run env-dev drizzle-kit migrate",
    "db-push-dev": "pnpm run env-dev drizzle-kit push",
    "db-studio-dev": "pnpm run env-dev drizzle-kit studio --port=8002 --config=./drizzle.config.ts"
  },
  "dependencies": {
    "cookie-parser": "~1.4.4",
    "debug": "~2.6.9",
    "drizzle-orm": "1.0.0-beta.21",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "google-auth-library": "^9.15.1",
    "http-errors": "~1.6.3",
    "jose": "^6.0.10",
    "morgan": "~1.9.1",
    "postgres": "^3.4.5",
    "zod": "^3.24.4"
  },
  "packageManager": "pnpm@10.6.3+sha512.bb45e34d50a9a76e858a95837301bfb6bd6d35aea2c5d52094fa497a467c43f5c440103ce2511e9e0a2f89c3d6071baac3358fc68ac6fb75e2ceb3d2736065e6",
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/debug": "^4.1.12",
    "@types/express": "^5.0.1",
    "@types/http-errors": "^2.0.4",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.14.0",
    "drizzle-kit": "1.0.0-beta.21",
    "eslint": "^9.24.0",
    "globals": "^16.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.29.0",
    "prettier": "^3.5.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}