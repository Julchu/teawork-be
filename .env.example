DATABASE_URL=""
STAGING_DATABASE_URL=""

# At least 32 characters each. Access and refresh secrets must differ.
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
NODE_ENV=""

# Development only. Honored when NODE_ENV=development. Never a replacement for a session cookie when one is present.
MASTER_KEY=""
MASTER_TEST_EMAIL=""

ACCESS_TOKEN_KEY="teawork_access_token"
REFRESH_TOKEN_KEY="teawork_refresh_token"

GOOGLE_CLIENT_ID=""
GOOGLE_PROJECT_ID=""
GOOGLE_AUTH_URI=""
GOOGLE_TOKEN_URI=""
GOOGLE_AUTH_PROVIDER_X509_CERT_URL=""
GOOGLE_CLIENT_SECRET=""
# Frontend origin + /api/login/google. Must match the frontend redirect URI and the Google Cloud client.
GOOGLE_REDIRECT_URIS=""

TEAWORK_URL=""

IPINFO_GEOLOCATION_API_KEY=""

# Hop count in front of the API (1 for a single ALB, nginx, or platform proxy).
# Leave unset locally. Required in deployed environments so POST /geo sees the visitor IP.
TRUST_PROXY=""
